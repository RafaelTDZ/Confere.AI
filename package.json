{
  "name": "confere-ia",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migration": "supabase migration new",
    "db:push": "supabase link --project-ref pavxbcsolcvekwslhzmf && supabase db push",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\" --ignore-path .gitignore"
  },
  "dependencies": {
    "next": "^16.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "supabase": "2.34.3",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase"
    ],
    "overrides": {
      "@ai-sdk/provider": "4.0.27",
      "js-yaml": "^4.3.2",
      "nanoid": "^3.3.20",
      "next>postcss": "^8.5.31",
      "sharp": "^0.35.5",
      "source-map-js": "^1.2.2",
      "tar": "^7.5.22",
      "undici": "^7.30.1"
    }
  }
}
