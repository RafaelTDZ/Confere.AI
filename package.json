{
  "name": "confere-ia",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migration": "supabase migration new",
    "db:push": "supabase link --project-ref xmvypuwizexdhpwrgrao && supabase db push",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\" --ignore-path .gitignore"
  },
  "dependencies": {
    "next": "^15.1.4"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "supabase": "2.34.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["supabase"],
    "overrides": {
      "@ai-sdk/provider": "4.0.27"
    }
  }
}
