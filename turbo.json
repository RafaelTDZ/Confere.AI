{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": [
    "ADMIN_EMAILS",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_SECRET_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "SUPABASE_INTERNAL_URL",
    "AI_PROVIDER",
    "FIREWORKS_API_KEY",
    "FIREWORKS_MODEL",
    "OPENROUTER_API_KEY",
    "OPENROUTER_MODEL",
    "OPENROUTER_REASONING_EFFORT",
    "OPENROUTER_REASONING_MAX_TOKENS",
    "OPENROUTER_REASONING_EXCLUDE",
    "AI_ANALYZE_RATE_LIMIT",
    "AI_ANALYZE_RATE_WINDOW_SECONDS",
    "AI_MONTHLY_TOKEN_QUOTA",
    "AI_TASK_TIMEOUT_MS",
    "AI_TASK_RETRIES",
    "CHECK_EMAIL_RATE_LIMIT",
    "CHECK_EMAIL_RATE_WINDOW_SECONDS",
    "CRON_SECRET",
    "FIRECRAWL_API_KEY",
    "FIRECRAWL_BASE_URL",
    "TRACKING_FIRECRAWL_MONTHLY_CREDITS",
    "TRACKING_FIRECRAWL_GLOBAL_CREDITS",
    "TRACKING_CARRIER_STRATEGY",
    "TRACKING_IN_TRANSIT_INTERVAL_MINUTES",
    "TRACKING_FAR_ETA_INTERVAL_MINUTES",
    "TRACKING_CONTAINER_FALLBACK_LIMIT",
    "TRACKING_REFRESH_COOLDOWN_MINUTES",
    "GEOCODE_BASE_URL",
    "GEOCODE_USER_AGENT",
    "DOCUMENT_PARSE_PROVIDER",
    "DOCUMENT_PARSE_MAX_PAGES",
    "DOCUMENT_PARSE_OCR_MODE",
    "DOCUMENT_PARSE_MONTHLY_CREDITS",
    "DOCUMENT_PARSE_MIN_CHARS",
    "DOCUMENT_PARSE_MAX_CHARS",
    "DOCUMENT_PARSE_TIMEOUT_MS",
    "OTEL_EXPORTER_OTLP_ENDPOINT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {},
    "test:coverage": {},
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
