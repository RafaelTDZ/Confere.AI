# --- Supabase ---
# Projeto cloud: https://xmvypuwizexdhpwrgrao.supabase.co
# Chaves em: Supabase Dashboard > Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xmvypuwizexdhpwrgrao.supabase.co
# Preferir publishable key (sb_publishable_...). Fallback: NEXT_PUBLIC_SUPABASE_ANON_KEY (JWT legado).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) ou service_role JWT legado — apenas servidor, se necessário.
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Override opcional do destino do proxy /supabase (route handler no servidor Next).
# Remova a linha ou deixe comentada para usar NEXT_PUBLIC_SUPABASE_URL.
# NÃO deixe vazio (SUPABASE_INTERNAL_URL=) — string vazia quebra o proxy.
# SUPABASE_INTERNAL_URL=

# --- OpenRouter (servidor) ---
# Chave em: https://openrouter.ai/settings/keys
# Usada por apps/web/src/lib/ai e GET /api/ai/health (autenticado).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna

# --- Observabilidade (opcional) ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
