# --- Supabase ---
# Projeto cloud: https://pavxbcsolcvekwslhzmf.supabase.co
# Chaves em: Supabase Dashboard > Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://pavxbcsolcvekwslhzmf.supabase.co
# Preferir publishable key (sb_publishable_...). Fallback: NEXT_PUBLIC_SUPABASE_ANON_KEY (JWT legado).
# Uma chave por linha — não cole o valor na mesma linha do comentário abaixo.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) ou service_role JWT legado — apenas servidor.
# Obrigatória para persistir extraction_results / ai_logs (POST /api/ai/analyze).
# SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Override opcional do destino do proxy /supabase (route handler no servidor Next).
# Remova a linha ou deixe comentada para usar NEXT_PUBLIC_SUPABASE_URL.
# NÃO deixe vazio (SUPABASE_INTERNAL_URL=) — string vazia quebra o proxy.
# SUPABASE_INTERNAL_URL=

# --- Provedor de IA (servidor) ---
# fireworks (padrão) | openrouter
AI_PROVIDER=fireworks

# --- Fireworks (servidor, provedor padrão) ---
# Chave em: https://app.fireworks.ai/settings/api-keys
# PDF não é aceito pela API; o servidor converte as páginas em imagens.
FIREWORKS_API_KEY=
# Padrão do servidor (a config global em /configuracoes vence).
FIREWORKS_MODEL=accounts/fireworks/routers/deepseek-flash-latest
# Alternativa explícita: accounts/fireworks/models/deepseek-v4p1-flash

# --- OpenRouter (servidor, opção alternativa) ---
# Chave em: https://openrouter.ai/settings/keys
# Usada por apps/web/src/lib/ai e GET /api/ai/health quando AI_PROVIDER=openrouter.
# Modelos: ~openai/gpt-luna-latest | meta/muse-spark-1.3 (troca em /configuracoes).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=~openai/gpt-luna-latest
# OPENROUTER_REASONING_EFFORT=low      # override: xhigh|high|medium|low|none
# OPENROUTER_REASONING_MAX_TOKENS=     # alternativa a effort (não usar os dois)
# OPENROUTER_REASONING_EXCLUDE=true    # remove reasoning tokens da resposta

# Allowlist de super-admins (emails separados por vírgula).
# Só esses emails acessam /configuracoes e /api/settings/ai.
# Vazio = ninguém tem acesso (negado por padrão).
ADMIN_EMAILS=

# Rate limit por tenant (análise de documentos) e quota mensal de IA.
AI_ANALYZE_RATE_LIMIT=30
AI_ANALYZE_RATE_WINDOW_SECONDS=3600
AI_MONTHLY_TOKEN_QUOTA=10000000
CHECK_EMAIL_RATE_LIMIT=10
CHECK_EMAIL_RATE_WINDOW_SECONDS=60

# Orçamento por chamada de IA (classify/extract_*): aborta e tenta de novo 1x.
# Sem isso, uma chamada travada consome o maxDuration da função e o job morre.
AI_TASK_TIMEOUT_MS=90000
AI_TASK_RETRIES=1

# --- Fila de análise (AI-01) ---
# Segredo do endpoint POST/GET /api/ai/jobs/run (retry/cron). Sem ele o endpoint responde 503.
# Use o mesmo valor em `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# --- Rastreio de BL/container (Firecrawl) ---
# Chave em: https://www.firecrawl.dev/app/settings
# Sem a chave, o rastreio fica "bloqueado" e a tela oferece link/manual.
FIRECRAWL_API_KEY=
# v1 usa extração JSON (5 créditos/página); portais são SPAs sem parser markdown dedicado.
TRACKING_FIRECRAWL_MONTHLY_CREDITS=3000
TRACKING_FIRECRAWL_GLOBAL_CREDITS=9000
# Estratégia por armador (padrão: firecrawl; MSC usa API própria, 0 créditos).
# TRACKING_CARRIER_STRATEGY=maersk=firecrawl,msc=http,cma=firecrawl,hapag=firecrawl,cosco=firecrawl,evergreen=firecrawl
# Intervalos de atualização automática (minutos).
# Diária quando falta ≤ 7 dias para o ETA; semanal (7 dias) com o ETA longe.
TRACKING_IN_TRANSIT_INTERVAL_MINUTES=1440
TRACKING_FAR_ETA_INTERVAL_MINUTES=10080
TRACKING_CONTAINER_FALLBACK_LIMIT=3
# Cache curto do botão "Atualizar": consulta recente não é repetida (0 desativa).
# Vale para sucesso e falha; cron e a primeira consulta da análise não usam.
TRACKING_REFRESH_COOLDOWN_MINUTES=30

# --- Geocodificação dos portos (mapa de rota do rastreio) ---
# Nominatim/OpenStreetMap: use um User-Agent identificável (política de uso).
GEOCODE_BASE_URL=https://nominatim.openstreetmap.org
GEOCODE_USER_AGENT=confere-ia/1.0 (contato@confere.ai)

# --- Parse de PDF em markdown (Firecrawl /v2/parse) ---
# firecrawl = OCR/markdown antes das tasks; images = mantém o pipeline atual.
DOCUMENT_PARSE_PROVIDER=firecrawl
DOCUMENT_PARSE_MAX_PAGES=30
DOCUMENT_PARSE_OCR_MODE=auto          # auto | ocr | fast
DOCUMENT_PARSE_MONTHLY_CREDITS=5000   # 0 = sem teto
DOCUMENT_PARSE_MIN_CHARS=200
DOCUMENT_PARSE_MAX_CHARS=120000
DOCUMENT_PARSE_TIMEOUT_MS=90000

# --- Observabilidade (OBS-03) ---
# Opcional: endpoint OTLP para traces/métricas fora da Vercel.
# Na Vercel, `@vercel/otel` envia para a observabilidade do próprio projeto.
# OTEL_EXPORTER_OTLP_ENDPOINT=
