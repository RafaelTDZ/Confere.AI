# --- Supabase ---
# Projeto cloud: https://pavxbcsolcvekwslhzmf.supabase.co
# Chaves em: Supabase Dashboard > Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://pavxbcsolcvekwslhzmf.supabase.co
# Preferir publishable key (sb_publishable_...). Fallback: NEXT_PUBLIC_SUPABASE_ANON_KEY (JWT legado).
# Uma chave por linha — não cole o valor na mesma linha do comentário abaixo.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) ou service_role JWT legado — apenas servidor.
# Obrigatória para persistir extraction_results / ai_logs (POST /api/ai/analyze).
# SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Override opcional do destino do proxy /supabase (route handler no servidor Next).
# Remova a linha ou deixe comentada para usar NEXT_PUBLIC_SUPABASE_URL.
# NÃO deixe vazio (SUPABASE_INTERNAL_URL=) — string vazia quebra o proxy.
# SUPABASE_INTERNAL_URL=

# --- OpenRouter (servidor, provedor único de IA) ---
# Chave em: https://openrouter.ai/settings/keys
# Usada por apps/web/src/lib/ai e GET /api/ai/health.
# Modelos: ~openai/gpt-luna-latest | meta/muse-spark-1.3 (troca em /configuracoes).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=~openai/gpt-luna-latest
# OPENROUTER_REASONING_EFFORT=low      # override: xhigh|high|medium|low|none
# OPENROUTER_REASONING_MAX_TOKENS=     # alternativa a effort (não usar os dois)
# OPENROUTER_REASONING_EXCLUDE=true    # remove reasoning tokens da resposta

# Allowlist de super-admins (emails separados por vírgula).
# Só esses emails acessam /configuracoes e /api/settings/ai.
# Vazio = ninguém tem acesso (negado por padrão).
ADMIN_EMAILS=

# Rate limit por tenant (análise de documentos) e quota mensal de IA.
AI_ANALYZE_RATE_LIMIT=30
AI_ANALYZE_RATE_WINDOW_SECONDS=3600
AI_MONTHLY_TOKEN_QUOTA=10000000
CHECK_EMAIL_RATE_LIMIT=10
CHECK_EMAIL_RATE_WINDOW_SECONDS=60

# --- Fila de análise (AI-01) ---
# Segredo do endpoint POST/GET /api/ai/jobs/run (retry/cron). Sem ele o endpoint responde 503.
# Use o mesmo valor em `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# --- Observabilidade (OBS-03) ---
# Opcional: endpoint OTLP para traces/métricas fora da Vercel.
# Na Vercel, `@vercel/otel` envia para a observabilidade do próprio projeto.
# OTEL_EXPORTER_OTLP_ENDPOINT=
