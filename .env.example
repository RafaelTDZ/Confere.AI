# ============================================================================
# Confere.AI — template de ambiente
#
#   cp .env.example .env      (e preencha apenas as chaves)
#
# O Next lê o .env da RAIZ do monorepo (apps/web/next.config.ts). Se existir
# .env.local na raiz, ele tem prioridade sobre o .env (use só para a CLI da
# Vercel). Todo valor abaixo de "OPCIONAIS" já tem default no código.
# ============================================================================

# ────────────────────────────────────────────────────────────────────────────
# OBRIGATÓRIAS
# ────────────────────────────────────────────────────────────────────────────

# --- Supabase (cloud) — Dashboard > Settings > API Keys ---
NEXT_PUBLIC_SUPABASE_URL=https://pavxbcsolcvekwslhzmf.supabase.co
# Publishable (sb_publishable_...): usada no browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (sb_secret_...) ou service_role JWT: só no servidor. Sem ela não grava
# Storage / extraction_results / ai_logs.
SUPABASE_SERVICE_ROLE_KEY=

# --- IA: Fireworks é o provedor padrão ---
# Chave: https://app.fireworks.ai/settings/api-keys
# A config global de /configuracoes vence este valor.
AI_PROVIDER=fireworks
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/routers/deepseek-flash-latest
# Alternativa explícita: accounts/fireworks/models/deepseek-v4p1-flash

# --- Firecrawl: rastreio de BL e parse de PDF em markdown ---
# Chave: https://www.firecrawl.dev/app/settings
# Sem ela: a análise segue (PDF vira imagem) e o rastreio fica manual.
FIRECRAWL_API_KEY=

# --- Cron/workers: Bearer de /api/ai/jobs/run e /api/tracking/run ---
# Sem ele esses endpoints respondem 503.
CRON_SECRET=

# --- Super-admin: acessa /admin e /configuracoes (vazio = ninguém) ---
ADMIN_EMAILS=

# ────────────────────────────────────────────────────────────────────────────
# OPCIONAIS — os valores mostrados são os defaults do código.
# Descomente só o que quiser mudar.
# ────────────────────────────────────────────────────────────────────────────

# --- OpenRouter (alternativa ao Fireworks) ---
# Para usar: AI_PROVIDER=openrouter (ou troque em /configuracoes).
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=~openai/gpt-luna-latest
# OPENROUTER_REASONING_EFFORT=low        # xhigh|high|medium|low|minimal|none
# OPENROUTER_REASONING_MAX_TOKENS=       # alternativa a effort (não usar os dois)
# OPENROUTER_REASONING_EXCLUDE=true      # remove reasoning tokens da resposta

# --- Limites de uso (rate limit por tenant e quota mensal) ---
# AI_ANALYZE_RATE_LIMIT=30
# AI_ANALYZE_RATE_WINDOW_SECONDS=3600
# AI_MONTHLY_TOKEN_QUOTA=10000000
# CHECK_EMAIL_RATE_LIMIT=10
# CHECK_EMAIL_RATE_WINDOW_SECONDS=60
# Orçamento por chamada de IA (aborta e tenta 1x de novo):
# AI_TASK_TIMEOUT_MS=90000
# AI_TASK_RETRIES=1

# --- Rastreio: orçamento de créditos e cadência ---
# TRACKING_FIRECRAWL_MONTHLY_CREDITS=3000     # por tenant; 0 = sem teto
# TRACKING_FIRECRAWL_GLOBAL_CREDITS=9000      # global; 0 = sem teto
# TRACKING_CONTAINER_FALLBACK_LIMIT=3
# TRACKING_IN_TRANSIT_INTERVAL_MINUTES=1440   # ETA a ≤ 7 dias (diária)
# TRACKING_FAR_ETA_INTERVAL_MINUTES=10080     # ETA longe (semanal)
# TRACKING_REFRESH_COOLDOWN_MINUTES=30        # botão "Atualizar"; 0 desativa
# TRACKING_CARRIER_STRATEGY=maersk=firecrawl,msc=http,cma=firecrawl,hapag=firecrawl,cosco=firecrawl,evergreen=firecrawl

# --- Geocodificação dos portos (mapa da rota do rastreio) ---
# Nominatim/OpenStreetMap: use um User-Agent identificável (política de uso).
# GEOCODE_BASE_URL=https://nominatim.openstreetmap.org
# GEOCODE_USER_AGENT=confere-ia/1.0 (contato@confere.ai)

# --- Parse de PDF em markdown (Firecrawl /v2/parse) ---
# images = desliga o parse e mantém PDF→imagem/PDF nativo.
# DOCUMENT_PARSE_PROVIDER=firecrawl
# DOCUMENT_PARSE_MAX_PAGES=30
# DOCUMENT_PARSE_OCR_MODE=auto                # auto | ocr | fast
# DOCUMENT_PARSE_MONTHLY_CREDITS=5000         # 0 = sem teto
# DOCUMENT_PARSE_MIN_CHARS=200
# DOCUMENT_PARSE_MAX_CHARS=120000
# DOCUMENT_PARSE_TIMEOUT_MS=90000

# --- Legado / avançado ---
# NEXT_PUBLIC_SUPABASE_ANON_KEY=            # fallback ao publishable (JWT)
# SUPABASE_SECRET_KEY=                      # fallback ao SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_INTERNAL_URL=                    # destino do proxy /supabase (NUNCA vazio)
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev
# OTEL_EXPORTER_OTLP_ENDPOINT=              # exporta traces fora da Vercel
